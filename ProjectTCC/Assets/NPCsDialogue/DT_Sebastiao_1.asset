  m_Name: DT_Sebastiao_1
  m_EditorClassIdentifier: 
  npcName: Sebastiao
  audioEntrada: {fileID: 0}
  nodes:
  - id: no_1
    mostrarNoInicio: 0
    perguntaTexto: "H\xE1 quanto tempo o senhor est\xE1 aqui?"
    respostaTexto: Desde menino. Uns cinquenta anos neste cafezal. Perdi a conta
      dos anos e perdi o nome que me deram em casa.
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: 
  - id: no_2
    mostrarNoInicio: 0
    perguntaTexto: "Como \xE9 o trabalho?"
    respostaTexto: "Do escuro ao escuro. Na colheita, mais. Quem n\xE3o enche o cesto,
      apanha. \xC9 simples assim."
    respostaAudio: {fileID: 0}
    substituirPor: no_2.1
    eventoId: 
  - id: no_2.1
    mostrarNoInicio: 0
    perguntaTexto: "E ningu\xE9m reclama?"
    respostaTexto: "Reclamar tem pre\xE7o. Mas tem quem trabalhe devagar de prop\xF3sito,
      quem quebre a ferramenta, quem amanhe\xE7a doente. Cada um resiste do jeito
      que d\xE1."
    respostaAudio: {fileID: 0}
    substituirPor: no_2.1
    eventoId: 
  - id: no_3
    mostrarNoInicio: 0
    perguntaTexto: "Quantos aqui chegam \xE0 sua idade?"
    respostaTexto: "Poucos. Muito poucos. A ro\xE7a come a gente bem antes disso.
      Eu sou o mais velho e sou uma exce\xE7\xE3o, n\xE3o uma regra."
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: 
  - id: no_4
    mostrarNoInicio: 0
    perguntaTexto: Posso ajudar?
    respostaTexto: "Pode. Pega o cesto. Gr\xE3o maduro \xE9 o vermelho \u2014 o verde
      estraga o lote e a culpa cai em mim."
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: 
