%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dbe8d2329ca146e42a5a9914070a68fd, type: 3}
  m_Name: DT_Sebastiao_2
  m_EditorClassIdentifier: 
  npcName: 
  audioEntrada: {fileID: 0}
  nodes:
  - id: no_1
    mostrarNoInicio: 1
    perguntaTexto: "Quando falei com o fazendeiro, ele disse que \"tomaram os velhos\".
      O senhor sabe o que \xE9 isso?"
    respostaTexto: "Ele est\xE1 falando da Lei dos Sexagen\xE1rios, do ano passado,
      1885. Libertou quem passou dos sessenta."
    respostaAudio: {fileID: 8300000, guid: d124d8f1ef4323d4ca854848d25b047e, type: 3}
    substituirPor: no_1.1
    eventoId: 
  - id: no_1.1
    mostrarNoInicio: 0
    perguntaTexto: "Ent\xE3o o senhor est\xE1 livre! Por que ainda est\xE1 aqui?"
    respostaTexto: "\u2014 Estou \"livre\" e continuo aqui. A lei manda servir mais
      tr\xEAs anos como indeniza\xE7\xE3o ao senhor. Chamam isso de liberdade."
    respostaAudio: {fileID: 8300000, guid: 18a920417ccd5fe4a93552c64259d7e1, type: 3}
    substituirPor: 
    eventoId: 
  - id: no_2
    mostrarNoInicio: 1
    perguntaTexto: "Ouvi gente reclamando dessa lei. Por qu\xEA?"
    respostaTexto: "Porque quase ningu\xE9m chega aos sessenta na lavoura voc\xEA
      mesmo me perguntou isso hoje de manh\xE3. E quem chega j\xE1 n\xE3o rende.
      Libertaram justamente quem eles n\xE3o queriam mais sustentar."
    respostaAudio: {fileID: 8300000, guid: f4f2b03f324f87c4c9c3950779c737aa, type: 3}
    substituirPor: no_2.1
    eventoId: 
  - id: no_2.1
    mostrarNoInicio: 0
    perguntaTexto: E para onde vai um velho liberto?
    respostaTexto: "Pra lugar nenhum. Sem terra, sem sal\xE1rio, sem os seus por
      perto. Muitos voltam pra porta da fazenda pedir comida a quem os tinha."
    respostaAudio: {fileID: 8300000, guid: 6750cc2101461254fac010fc072303ad, type: 3}
    substituirPor: 
    eventoId: 
  - id: no_3
    mostrarNoInicio: 1
    perguntaTexto: "Seu Sebasti\xE3o, o senhor nasceu no Brasil?"
    respostaTexto: "N\xE3o. Nasci do outro lado do mar. Cheguei menino, num navio
      que veio \xE0 noite, numa praia sem porto nenhum. Nunca entendi por que foi
      \xE0s escondidas."
    respostaAudio: {fileID: 8300000, guid: 50408421cefec0e48991c8c635cd2dd6, type: 3}
    substituirPor: no_3.1
    eventoId: 
  - id: no_3.1
    mostrarNoInicio: 0
    perguntaTexto: "Eu sei por qu\xEA. O nome do senhor est\xE1 no livro do patr\xE3o:
      entrada em 1834."
    respostaTexto: "Mil oitocentos e trinta e quatro. E da\xED?"
    respostaAudio: {fileID: 8300000, guid: 96bfd052eed434d439fe87d7e0857103, type: 3}
    substituirPor: no_3.2
    eventoId: 
  - id: no_3.2
    mostrarNoInicio: 0
    perguntaTexto: "Desde 1831 era proibido trazer gente da \xC1frica. Quem desembarcou
      depois disso era livre por lei. O senhor nunca foi legalmente escravo."
    respostaTexto: "Cinquenta anos, mo\xE7o. Cinquenta anos."
    respostaAudio: {fileID: 8300000, guid: 7659d3a430f36904daec2d5c16fead72, type: 3}
    substituirPor: no_3.3
    eventoId: 
  - id: no_3.3
    mostrarNoInicio: 0
    perguntaTexto: "\u2014 O senhor pode ir \xE0 Justi\xE7a com isso."
    respostaTexto: "Eu n\xE3o sei ler. Mas voc\xEA acabou de ler pra mim. Talvez
      seja assim que come\xE7a."
    respostaAudio: {fileID: 8300000, guid: d61e2518fb110e34ab242663378f700b, type: 3}
    substituirPor: 
    eventoId: 
  - id: no_4
    mostrarNoInicio: 1
    perguntaTexto: "O senhor j\xE1 pensou em fugir?"
    respostaTexto: "J\xE1 pensei, e j\xE1 vi gente conseguir. V\xE1 falar com o Z\xE9,
      l\xE1 na carro\xE7a. Ele vive na vila, sabe das coisas que a gente aqui n\xE3o
      sabe."
    respostaAudio: {fileID: 8300000, guid: 2414d6a0988fdaf4f8cd38c7fadece62, type: 3}
    substituirPor: 
    eventoId: ze_aparecer
