  m_Name: DT_Gama_CasaP2
  m_EditorClassIdentifier: 
  npcName: Gama
  audioEntrada: {fileID: 0}
  nodes:
  - id: no_1
    mostrarNoInicio: 1
    perguntaTexto: O que eu deveria fazer agora?
    respostaTexto: Procura documentos, qualquer coisa que ajude a gente, eu vou ir
      pro curando por aqui tambem.
    respostaAudio: {fileID: 8300000, guid: ccece8f22d28d3946b0daae069d74eb2, type: 3}
    substituirPor: 
    eventoId: Iniciar_Pergaminhos
  - id: no_2
    mostrarNoInicio: 1
    perguntaTexto: Tem alguma ideia de como abrir o cofre?
    respostaTexto: "N\xE3o sou serralheiro. Mas ele parece um homem cuidadoso. Duvido
      que tenha deixado uma senha \xE0 vista. Talvez algum botao escondido."
    respostaAudio: {fileID: 8300000, guid: f50d00283322f0e439da5411e919f614, type: 3}
    substituirPor: 
    eventoId: 
  - id: no_3
    mostrarNoInicio: 1
    perguntaTexto: "Por que esse papel \xE9 t\xE3o importante?"
    respostaTexto: "Porque, neste pa\xEDs, a liberdade precisa de testemunha e de
      documento. Pessoas livres foram sequestradas e vendidas. Libertos tiveram suas
      cartas rasgadas e foram mandados de volta ao cativeiro. Fizeram isso comigo."
    respostaAudio: {fileID: 8300000, guid: e82ac9a5f999b9444b06d5bbdac5e3c8, type: 3}
    substituirPor: no_3.1
    eventoId: 
  - id: no_3.1
    mostrarNoInicio: 0
    perguntaTexto: E depois? O que se faz?
    respostaTexto: "Vai-se \xE0 Justi\xE7a. \xC9 uma a\xE7\xE3o de liberdade: a pessoa
      entra no tribunal para exigir que sua condi\xE7\xE3o de livre seja reconhecida."
    respostaAudio: {fileID: 8300000, guid: cc7aaace2a6428343a02b84e5d29bd92, type: 3}
    substituirPor: 
    eventoId: 
  - id: no_4
    mostrarNoInicio: 1
    perguntaTexto: "Voc\xEA parece conhecer muito bem esse tipo de lugar. J\xE1 esteve
      aqui?"
    respostaTexto: "Em cem lugares como este. Sempre pela porta dos fundos, sempre
      com um processo debaixo do bra\xE7o... e, muitas vezes, saindo com algu\xE9m
      que havia entrado tratado como coisa."
    respostaAudio: {fileID: 8300000, guid: 6bb6ea070877fcd499ec0798e370c892, type: 3}
    substituirPor: 
    eventoId: 
