  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dbe8d2329ca146e42a5a9914070a68fd, type: 3}
  m_Name: DT_Ze_1
  m_EditorClassIdentifier: 
  npcName: 
  audioEntrada: {fileID: 0}
  nodes:
  - id: no_1
    mostrarNoInicio: 1
    perguntaTexto: "Voc\xEA \xE9 daqui da fazenda?"
    respostaTexto: "N\xE3o. Sou da vila. Meu senhor me aluga: eu trabalho na rua,
      no porto, na carro\xE7a, e entrego a ele o que ganho no fim do dia. Chamam
      isso de escravo de ganho."
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: 
  - id: no_2
    mostrarNoInicio: 1
    perguntaTexto: "Como \xE9 ser escravizado na cidade?"
    respostaTexto: "\xC9 outro peso. A gente anda solto, vende, carrega, conversa
      com todo mundo. Mas cada moeda tem dono, e o dono n\xE3o sou eu."
    respostaAudio: {fileID: 0}
    substituirPor: no_2.1
    eventoId: 
  - id: no_2.1
    mostrarNoInicio: 0
    perguntaTexto: "Ent\xE3o \xE9 melhor que aqui?"
    respostaTexto: "\xC9 diferente. Aqui voc\xEA apanha do feitor; l\xE1 voc\xEA
      apanha da pol\xEDcia. E l\xE1, se voc\xEA n\xE3o render, ele te vende pra ro\xE7a,
      que \xE9 com o que eles amea\xE7am a gente a vida inteira."
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: 
  - id: no_3
    mostrarNoInicio: 1
    perguntaTexto: Que trabalhos existem na vila?
    respostaTexto: "Tudo. Carregador, barbeiro, quitandeira, ferreiro, carpinteiro,
      sapateiro, costureira, ama de leite, cozinheira de casa grande. Muita gente
      escravizada tem of\xEDcio de mestre e ningu\xE9m nunca perguntou o nome dela."
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: 
  - id: no_4
    mostrarNoInicio: 1
    perguntaTexto: Precisa de ajuda?
    respostaTexto: "Preciso. Os sacos est\xE3o no armaz\xE9m, atr\xE1s da tulha.
      Traz um de cada vez e dobra o joelho, sen\xE3o voc\xEA quebra as costas antes
      dos trinta."
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: fugitivo_aparecer
