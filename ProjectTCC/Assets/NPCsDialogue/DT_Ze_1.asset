MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dbe8d2329ca146e42a5a9914070a68fd, type: 3}
  m_Name: DT_Ze_1
  m_EditorClassIdentifier: 
  npcName: "Z\xE9"
  audioEntrada: {fileID: 0}
  nodes:
  - id: no_1
    mostrarNoInicio: 1
    perguntaTexto: "Voc\xEA \xE9 daqui da fazenda?"
    respostaTexto: "N\xE3o. Sou da vila. Meu senhor me aluga: eu trabalho na rua,
      no porto, na carro\xE7a, e entrego a ele o que ganho no fim do dia. Chamam
      isso de escravo de ganho."
    respostaAudio: {fileID: 8300000, guid: 22149ce94c1e75f419137d3391db0c0d, type: 3}
    substituirPor: 
    eventoId: 
  - id: no_2
    mostrarNoInicio: 1
    perguntaTexto: "Como \xE9 ser escravizado na cidade?"
    respostaTexto: "\xC9 outro peso. A gente anda solto, vende, carrega, conversa
      com todo mundo. Mas cada moeda tem dono, e o dono n\xE3o sou eu."
    respostaAudio: {fileID: 8300000, guid: 0fbc69f07c84ef44b9c51baf16f1d179, type: 3}
    substituirPor: no_2.1
    eventoId: 
  - id: no_2.1
    mostrarNoInicio: 0
    perguntaTexto: "Ent\xE3o \xE9 melhor que aqui?"
    respostaTexto: "\xC9 diferente. Aqui voc\xEA apanha do feitor; l\xE1 voc\xEA
      apanha da pol\xEDcia. E l\xE1, se voc\xEA n\xE3o render, ele te vende pra ro\xE7a,
      que \xE9 com o que eles amea\xE7am a gente a vida inteira."
    respostaAudio: {fileID: 8300000, guid: 4811b6e81ae967d45a2b3f2050592a22, type: 3}
    substituirPor: no_2.2
    eventoId: 
  - id: no_2.2
    mostrarNoInicio: 0
    perguntaTexto: "Voc\xEA conhece gente que conseguiu sair?"
    respostaTexto: "Conhe\xE7o. E \xE9 tudo o que eu vou dizer sobre isso."
    respostaAudio: {fileID: 8300000, guid: d49bfdfb063eda9488e656e73c3e2a86, type: 3}
    substituirPor: 
    eventoId: 
  - id: no_3
    mostrarNoInicio: 1
    perguntaTexto: "Com o que voc\xEA trabalha na vila?"
    respostaTexto: "Tudo. Carregador, barbeiro, ferreiro, carpinteiro ate sapateiro.
      Muita gente escravizada tem of\xEDcio de mestre e ningu\xE9m nunca perguntou
      o nome dela."
    respostaAudio: {fileID: 8300000, guid: 4373180d5f699144d9c34b98cc350531, type: 3}
    substituirPor: 
    eventoId: 
  - id: no_4
    mostrarNoInicio: 1
    perguntaTexto: "Voc\xEA parece cansado. Precisa de ajuda?"
    respostaTexto: "Preciso. O saco est\xE1 no armaz\xE9m, atr\xE1s da tulha. Traz
      ele e dobra o joelho, sen\xE3o voc\xEA quebra as costas antes dos trinta."
    respostaAudio: {fileID: 8300000, guid: 878d96f04665077478fc638b634e037e, type: 3}
    substituirPor: 
    eventoId: fugitivo_aparecer
