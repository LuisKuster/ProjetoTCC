  m_Script: {fileID: 11500000, guid: dbe8d2329ca146e42a5a9914070a68fd, type: 3}
  m_Name: DT_Gama_CasaP1
  m_EditorClassIdentifier: 
  npcName: 
  audioEntrada: {fileID: 0}
  nodes:
  - id: no_1
    mostrarNoInicio: 0
    perguntaTexto: "Quem \xE9 voc\xEA?"
    respostaTexto: "Luiz Gama. Nasci livre, em Salvador, em 1830. Minha m\xE3e, Lu\xEDsa
      Mahin, era africana e liberta."
    respostaAudio: {fileID: 0}
    substituirPor: no_1.1
    eventoId: 
  - id: no_1.1
    mostrarNoInicio: 0
    perguntaTexto: Conta mais
    respostaTexto: "Aos dez anos meu pr\xF3prio pai me vendeu como escravo, pra pagar
      d\xEDvida de jogo. Vendeu o filho, nascido livre."
    respostaAudio: {fileID: 0}
    substituirPor: n_1.2
    eventoId: 
  - id: no_1.2
    mostrarNoInicio: 0
    perguntaTexto: E dpois?
    respostaTexto: "Aprendi a ler aos dezessete, com um estudante de Direito. Foi
      lendo que encontrei a prova de que eu era livre, e provei. Ler foi a \xFAnica
      arma que me deixaram pegar."
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: 
  - id: no_2
    mostrarNoInicio: 0
    perguntaTexto: 'E o que voce fazia? '
    respostaTexto: "Eu era uma especie de advogado mas Nunca tive diploma. Chamam
      gente como eu de r\xE1bula. Ainda assim tirei mais de quinhentas pessoas do
      cativeiro, no papel e no grito."
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: 
  - id: no_3
    mostrarNoInicio: 0
    perguntaTexto: Como conseguiu a liberdade?
    respostaTexto: Porque eu morri em 1882, e estamos em 1886. Na verdade nem eu
      sei por que eu to aqui tambem, deve ter alguma ccoisa pendende que precisa
      de mim
    respostaAudio: {fileID: 0}
    substituirPor: no_3.1
    eventoId: 
  - id: no_4
    mostrarNoInicio: 0
    perguntaTexto: Voce tem alguma dica pra mim?
    respostaTexto: "Bom fala com as pessoas essa \xE9 a melhor forma de conseguir
      informa\xE7oes, procurar realtos e documentos sempre ajuda."
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: 
