  audioEntrada: {fileID: 0}
  nodes:
  - id: no_1
    mostrarNoInicio: 1
    perguntaTexto: "Quem \xE9 voce?"
    respostaTexto: "meu nome \xE9 benedita eu trabalho aqui a um bom tempo, voce
      deve ser novo por aqui."
    respostaAudio: {fileID: 0}
    substituirPor: no_1.1
    eventoId: 
  - id: no_1.1
    mostrarNoInicio: 0
    perguntaTexto: "O que voc\xEA faz aqui? "
    respostaTexto: "Cozinho, lavo, engomo, sirvo e cuido das crian\xE7as da casa.
      Come\xE7o antes do sol e termino depois dele. "
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: 
  - id: no_1.2
    mostrarNoInicio: 0
    perguntaTexto: "nossa quanto trabalho, e quando Voc\xEA descansa?  "
    respostaTexto: "Domingo de manh\xE3, se a casa deixar. E olhe l\xE1."
    respostaAudio: {fileID: 0}
    substituirPor: no_4.2
    eventoId: cha_iniciado
  - id: no_2
    mostrarNoInicio: 1
    perguntaTexto: "Voc\xEA mora nesta casa?"
    respostaTexto: "Durmo num cub\xEDculo atr\xE1s da cozinha. Estar perto dos senhores
      n\xE3o \xE9 privil\xE9gio \xE9 ter os olhos deles em cima o dia inteiro."
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: 
  - id: no_3
    mostrarNoInicio: 1
    perguntaTexto: "Voc\xEA tem filhos?"
    respostaTexto: "Tenho um. O Tom\xE9. Ele nasceu livre  e o papel que prova isso
      est\xE1 trancado no cofre do escrit\xF3rio."
    respostaAudio: {fileID: 0}
    substituirPor: no_3.1
    eventoId: 
  - id: no_3.1
    mostrarNoInicio: 0
    perguntaTexto: Como assim, nasceu livre?
    respostaTexto: "Tem uma lei de 1871. Mas lei sem papel n\xE3o vale nada. Sem
      aquele papel, meu filho \xE9 escravo do jeito que ele quiser dizer que \xE9."
    respostaAudio: {fileID: 0}
    substituirPor: 
    eventoId: 
  - id: no_3.2
    mostrarNoInicio: 0
    perguntaTexto: "Por que voc\xEA n\xE3o pega?  "
    respostaTexto: "Voce realmente acha que o patrao vai deixar? alem do mais o papel
      esta no cofre na sala dele, e ele quase nunca sai de l\xE1.\r\n"
    respostaAudio: {fileID: 0}
    substituirPor: no_4.2
    eventoId: cha_iniciado
  - id: no_4
    mostrarNoInicio: 1
    perguntaTexto: "Por que voc\xEA n\xE3o pega?"
    respostaTexto: 'o patrao guarda tudo la no cofre, mas duvido que ele deixe voce
      pegar.

'
    respostaAudio: {fileID: 0}
    substituirPor: no_4.1
    eventoId: 
  - id: no_4.1
    mostrarNoInicio: 0
    perguntaTexto: "Tenho que achar um jeito de tirar ele do escrit\xF3rio, mas como? "
    respostaTexto: " a gente pode encehr ele de ch\xE1, alguma hora ele tenha que
      ir no baneiro."
    respostaAudio: {fileID: 0}
    substituirPor: no_4.2
    eventoId: 
  - id: no_4.2
    mostrarNoInicio: 0
    perguntaTexto: "otima idea, aonde estao os ingredientes? eu fa\xE7o e trago para
      voce."
    respostaTexto: "a chaleira est\xE1 no fogao, a xicara esta na sala de jantar,
      e o cha esta na dispensa, faz o cha e eu levo pra ele."
    respostaAudio: {fileID: 0}
    substituirPor: no_4.2
    eventoId: cha_iniciado
