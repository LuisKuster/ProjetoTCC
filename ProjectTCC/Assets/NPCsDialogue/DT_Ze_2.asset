  m_Script: {fileID: 11500000, guid: dbe8d2329ca146e42a5a9914070a68fd, type: 3}
  m_Name: DT_Ze_2
  m_EditorClassIdentifier: 
  npcName: "Z\xE9"
  audioEntrada: {fileID: 0}
  nodes:
  - id: no_1
    mostrarNoInicio: 1
    perguntaTexto: "Voc\xEA fica com alguma coisa do que ganha?"
    respostaTexto: "Se eu ganhar acima do combinado, o resto \xE9 meu pec\xFAlio.
      Guardo h\xE1 nove anos, numa caixa que tamb\xE9m n\xE3o \xE9 minha."
    respostaAudio: {fileID: 8300000, guid: 3e9e5ef0c98a4764f89addb45ff3e0f3, type: 3}
    substituirPor: no_1.1
    eventoId: 
  - id: no_1.1
    mostrarNoInicio: 0
    perguntaTexto: "Pra qu\xEA?"
    respostaTexto: "Pra comprar minha carta de alforria. \xC9 caro. Muita gente morre
      juntando."
    respostaAudio: {fileID: 8300000, guid: 23bfd7669fe18754f9871e2eb25382ad, type: 3}
    substituirPor: no_1.2
    eventoId: 
  - id: no_1.2
    mostrarNoInicio: 0
    perguntaTexto: Sozinho?
    respostaTexto: "A irmandade. A gente se cotiza, compra a liberdade de um por
      vez, e esse a\xED ajuda o pr\xF3ximo. \xC9 devagar, mas \xE9 nosso e ningu\xE9m
      nos deu."
    respostaAudio: {fileID: 8300000, guid: 528cd24be8ef6794084eb201371b115a, type: 3}
    substituirPor: 
    eventoId: 
  - id: no_2
    mostrarNoInicio: 1
    perguntaTexto: O que se fala na vila?
    respostaTexto: "Que tem gente sumindo das fazendas toda semana. E que tem gente
      na cidade escondendo quem some. N\xE3o ouviu de mim."
    respostaAudio: {fileID: 8300000, guid: f220ab7fdf4244642898ad4a9c001781, type: 3}
    substituirPor: 
    eventoId: 
  - id: no_2.1
    mostrarNoInicio: 0
    perguntaTexto: "Voc\xEA j\xE1 ajudou algu\xE9m a sumir?"
    respostaTexto: "Eu carrego caf\xE9. S\xF3 isso. Mas quem carrega caf\xE9 entra
      e sai de fazenda o dia inteiro, e ningu\xE9m repara numa carro\xE7a."
    respostaAudio: {fileID: 8300000, guid: 0c8bfb5e6de12e9448a0278221b824ee, type: 3}
    substituirPor: 
    eventoId: 
  - id: no_3
    mostrarNoInicio: 1
    perguntaTexto: O que se fala nos Jornais?
    respostaTexto: "Tem uns homens que n\xE3o param de escrever. Jos\xE9 do Patroc\xEDnio
      nos jornais do Rio, que n\xE3o deixa o assunto morrer. Joaquim Nabuco, que
      leva a briga pro Parlamento. Andr\xE9 Rebou\xE7as, engenheiro, que diz que
      n\xE3o basta libertar tem que dar terra."
    respostaAudio: {fileID: 8300000, guid: a55e7ddbc07b5c447b071b7b71d6acb4, type: 3}
    substituirPor: no_3.1
    eventoId: 
  - id: no_3.1
    mostrarNoInicio: 0
    perguntaTexto: Isso adianta alguma coisa?
    respostaTexto: "Junta com o resto. Uns escrevem, outros fogem, outros processam,
      outros escondem. Cada um puxa um peda\xE7o. Um dia a corda arrebenta."
    respostaAudio: {fileID: 8300000, guid: 35b32027d8eeb744f95e9f7d32eac08a, type: 3}
    substituirPor: 
    eventoId: 
  - id: no_4
    mostrarNoInicio: 1
    perguntaTexto: Ja tenho tudo que eu preciso, poderia me dar uma carona?
    respostaTexto: Claro,  sobe ai, eu te deixo na cidade.
    respostaAudio: {fileID: 8300000, guid: daf157fb8902cf54784432ee2e814200, type: 3}
    substituirPor: 
    eventoId: Final
